{
  "name": "streamx",
  "version": "1.0.0",
  "description": "Plataforma de streaming full-stack para películas, series y TV en vivo",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "backend:api": "cd backend && npm start",
    "frontend": "cd frontend && npm start",
    "build": "echo 'Build completo - ver subdirectorios'",
    "test": "echo 'Tests pendientes de implementar'",
    "lint": "eslint . --ext .js,.jsx",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrateToCloud.js",
    "fill-metadata": "node scripts/fillMetadata.js",
    "import-bulk": "node scripts/bulkImport.js"
  },
  "keywords": [
    "streaming",
    "peliculas",
    "series",
    "tv-vivo",
    "iptv",
    "hls",
    "tmdb",
    "mongodb",
    "express",
    "react"
  ],
  "author": "StreamX Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/streamx.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/streamx/issues"
  },
  "homepage": "https://github.com/tu-usuario/streamx#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.x",
    "npm": ">=8.x"
  }
